  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "{{rw.flavors.light.editor.comment}}", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template", "string.other.link", "punctuation.definition.string"],
      "settings": { "foreground": "{{rw.flavors.light.editor.steel}}" }
    },
    {
      "name": "Escapes and regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.regexp"],
      "settings": { "foreground": "{{rw.flavors.light.editor.salmon}}" }
    },
    {
      "name": "Number, Boolean, Constant",
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant", "variable.other.constant", "constant.other", "variable.other.enummember"],
      "settings": { "foreground": "{{rw.flavors.light.editor.gold}}" }
    },
    {
      "name": "Builtins and magic values",
      "scope": ["variable.language", "variable.builtin", "support.variable.magic", "meta.definition.variable.language"],
      "settings": { "foreground": "{{rw.flavors.light.editor.gold}}", "fontStyle": "italic" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "keyword.other"],
      "settings": { "foreground": "{{rw.flavors.light.editor.rose}}" }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "{{rw.flavors.light.editor.rose}}", "fontStyle": "italic" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation.operator", "meta.brace", "punctuation"],
      "settings": { "foreground": "{{rw.flavors.light.editor.fg_dim}}" }
    },
    {
      "name": "Function definition",
      "scope": ["entity.name.function", "meta.definition.function"],
      "settings": { "foreground": "{{rw.flavors.light.editor.rose_bright}}", "fontStyle": "bold" }
    },
    {
      "name": "Function call",
      "scope": ["support.function", "meta.function-call", "variable.function", "entity.name.function.call", "meta.require.js"],
      "settings": { "foreground": "{{rw.flavors.light.editor.rose}}" }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "entity.other.inherited-class", "support.type", "support.class", "meta.type"],
      "settings": { "foreground": "{{rw.flavors.light.editor.steel_bright}}" }
    },
    {
      "name": "Namespace, Module",
      "scope": ["entity.name.namespace", "entity.name.module", "support.other.namespace", "meta.import"],
      "settings": { "foreground": "{{rw.flavors.light.editor.fg_dim}}", "fontStyle": "italic" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "{{rw.flavors.light.editor.rose_bright}}", "fontStyle": "bold" }
    },
    {
      "name": "Attribute, property",
      "scope": ["entity.other.attribute-name", "meta.attribute", "meta.object-literal.key", "variable.other.property", "variable.other.member"],
      "settings": { "foreground": "{{rw.flavors.light.editor.fg_dim}}" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.parameter", "punctuation.definition.variable.parameter"],
      "settings": { "foreground": "{{rw.flavors.light.editor.fg}}", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "identifier"],
      "settings": { "foreground": "{{rw.flavors.light.editor.fg}}" }
    },
    {
      "name": "Decorator",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.definition.decorator"],
      "settings": { "foreground": "{{rw.flavors.light.editor.steel_bright}}", "fontStyle": "italic" }
    },
    {
      "name": "Preprocessor",
      "scope": ["meta.preprocessor", "keyword.control.import", "keyword.control.export"],
      "settings": { "foreground": "{{rw.flavors.light.editor.steel}}" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "{{rw.flavors.light.editor.red}}" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated", "meta.diff.deleted"],
      "settings": { "foreground": "{{rw.flavors.light.editor.red}}", "fontStyle": "strikethrough" }
    },
    {
      "name": "Markup Heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "{{rw.flavors.light.editor.rose_bright}}", "fontStyle": "bold" }
    },
    {
      "name": "Markup Link",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "{{rw.flavors.light.editor.steel_bright}}", "fontStyle": "underline" }
    },
    {
      "name": "Markup Raw",
      "scope": ["markup.raw", "markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "{{rw.flavors.light.editor.steel}}" }
    },
    {
      "name": "Markup Italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markup Bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markup Quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "{{rw.flavors.light.editor.comment}}", "fontStyle": "italic" }
    },
    {
      "name": "Diff Inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"],
      "settings": { "foreground": "{{rw.flavors.light.editor.steel_bright}}" }
    },
    {
      "name": "Diff Deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"],
      "settings": { "foreground": "{{rw.flavors.light.editor.red}}" }
    },
    {
      "name": "Diff Changed",
      "scope": ["markup.changed", "punctuation.definition.changed"],
      "settings": { "foreground": "{{rw.flavors.light.editor.gold}}" }
    }
  ]
