{
  "name": "rosewood",
  "displayName": "Rosewood",
  "description": "Rosewood palette themes (dark, light, black) generated by the rosewood desktop CLI.",
  "version": "0.1.0",
  "publisher": "z3nnix",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "rosewood",
    "theme",
    "dark",
    "light",
    "black"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Rosewood Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/rosewood-dark.json"
      },
      {
        "label": "Rosewood Light",
        "uiTheme": "vs",
        "path": "./themes/rosewood-light.json"
      },
      {
        "label": "Rosewood Black",
        "uiTheme": "vs-dark",
        "path": "./themes/rosewood-black.json"
      }
    ],
    "commands": [
      {
        "command": "rosewood.reloadTheme",
        "title": "Rosewood: Reload Theme"
      }
    ],
    "configuration": {
      "title": "Rosewood",
      "properties": {
        "rosewood.autoReloadWindow": {
          "type": "boolean",
          "default": false,
          "description": "Reload the window when a Rosewood theme file changes and re-applying the theme is not enough."
        }
      }
    }
  }
}
